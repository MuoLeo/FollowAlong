# Explicitly approved small fixtures may be committed here.
# Review file size and content before adding anything to these directories.
!/tests/fixtures/**/*.mp4
!/tests/fixtures/**/*.wav
!/ai/tests/fixtures/**/*.mp4
!/ai/tests/fixtures/**/*.wav

